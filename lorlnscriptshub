    local function updateStatus(msg, msgType, duration)
        if statusTimer then
            pcall(function() statusTimer:Disconnect() end)
            statusTimer = nil
        end
        
        StatusLabel.Text = msg
        
        local colors = {
            success = {THEME.Success, THEME.Success},
            error = {THEME.Error, THEME.Error},
            warning = {THEME.Warning, THEME.Warning},
            loading = {THEME.Accent, THEME.Accent},
            idle = {Color3.fromRGB(100, 100, 100), Color3.fromRGB(150, 150, 170)}
        }
        
        local iconColor, textColor = unpack(colors[msgType] or colors.idle)
        
        StatusIcon.TextColor3 = iconColor
        StatusLabel.TextColor3 = textColor
        
        if msgType == "success" then StatusIcon.Text = "✓"
        elseif msgType == "error" then StatusIcon.Text = "X"
        elseif msgType == "warning" then StatusIcon.Text = "!"
        elseif msgType == "loading" then StatusIcon.Text = "●"
        else StatusIcon.Text = "●" end
        
        if duration and duration > 0 then
            statusTimer = task.delay(duration, function()
                pcall(function()
                    if StatusLabel and StatusLabel.Text == msg then
                        updateStatus("Ready", "idle")
                    end
                end)
                statusTimer = nil
            end)
        end
    end

