local KEY_URL = "https://lorlnkey.lorlnl9lor1.workers.dev/key"
local serverKey = nil

local function fetchServerKey()
    local success, result = pcall(function()
        return game:HttpGet(KEY_URL)
    end)
    
    if success and result and result ~= "" then
        serverKey = result:gsub("%s+", ""):upper()
        return true
    else
        warn("فشل جلب المفتاح من السيرفر")
        return false
    end
end

local KeyValidator = {
    keyServerUrl = KEY_URL
}

function KeyValidator.fetchKeyFromServer()
    if serverKey then
        return serverKey
    end
    
    local success = fetchServerKey()
    if success then
        return serverKey
    end
    
    return nil
end

function KeyValidator.checkKeyValid(key)
    if not serverKey then
        fetchServerKey()
    end
    
    if serverKey then
        local enteredKey = key:gsub("%s+", ""):upper()
        if enteredKey == serverKey then
            return true
        end
    end
    
    local gitSuccess, gitKeys = pcall(function()
        local response = game:HttpGet("https://raw.githubusercontent.com/LORLN9/LORLN-PRO/refs/heads/main/Key", true)
        local keys = {}
        for line in response:gmatch("[^\r\n]+") do
            local cleanLine = line:gsub("%s+", ""):upper()
            if cleanLine ~= "" and #cleanLine > 3 then
                keys[cleanLine] = true
            end
        end
        return keys
    end)
    
    if gitSuccess and gitKeys then
        if gitKeys[key:upper()] then
            return true
        end
    end
    
    if key:upper():sub(1,9) == "KEY_LORLN" then
        return true
    end
    
    return false
end

